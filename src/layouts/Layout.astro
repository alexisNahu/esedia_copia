---
import '../styles/global.css'
interface Props { title: string; }
import ClientRouter from 'astro/components/ClientRouter.astro';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
	<ClientRouter />
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
	<title>{title}</title>
</head>
<body class="bg-white font-['Inter'] text-slate-800">
<slot />
</body>
</html>

<style is:global>
	h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
</style>
