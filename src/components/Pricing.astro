---
const plans = [
    { name: 'ESENCIAL', price: '29', features: ['Diseño estándar', 'PDF interactivo', 'Confirmación básica'], highlight: false },
    { name: 'PREMIUM', price: '59', features: ['Audio de bienvenida', 'Confirmación vía WhatsApp', 'Mapa de recepción', 'Cuenta regresiva'], highlight: true },
    { name: 'EVENTO', price: '99', features: ['Todo lo del Premium', 'Dominio personalizado', 'Soporte prioritario'], highlight: false }
];
---
<section class="bg-slate-50 py-24 px-6">
    <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-4xl italic mb-12">Nuestros Planes</h2>

        <div class="grid md:grid-cols-3 gap-8 items-center">
            {plans.map(plan => (
                    <div class={`bg-white p-8 rounded-2xl shadow-sm border ${plan.highlight ? 'border-blue-500 ring-2 ring-blue-500/20 scale-105' : 'border-slate-100'}`}>
                        <h3 class="text-sm font-bold tracking-widest text-slate-400">{plan.name}</h3>
                        <div class="my-6">
                            <span class="text-4xl font-bold">${plan.price}</span>
                            <span class="text-slate-500">/ evento</span>
                        </div>
                        <ul class="text-left space-y-4 mb-8">
                            {plan.features.map(f => (
                                    <li class="flex items-center gap-3 text-sm text-slate-600 italic">
                                        <span class="text-blue-500">✓</span> {f}
                                    </li>
                            ))}
                        </ul>
                        <button class={`w-full py-3 rounded-full transition ${plan.highlight ? 'bg-[#1e4b7a] text-white hover:bg-blue-900' : 'bg-blue-100 text-blue-800 hover:bg-blue-200'}`}>
                            Elegir Plan
                        </button>
                    </div>
            ))}
        </div>
    </div>
</section>
