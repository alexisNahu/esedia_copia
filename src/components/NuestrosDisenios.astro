---
// src/components/NuestrosDisenios.astro
import { Image } from "astro:assets";

// Importaciones manuales para evitar errores de undefined
import inv1 from "../assets/nuestros_disenios/item1.png";
import inv2 from "../assets/nuestros_disenios/item2.png";
import inv3 from "../assets/nuestros_disenios/item3.png";
import inv4 from "../assets/nuestros_disenios/item4.png";

const designs = [
    { title: "L'Amour Minimaliste", tag: "EDICIÓN BODA", img: inv1 },
    { title: "Modern Abstract", tag: "EDICIÓN CUMPLEAÑOS", img: inv2 },
    { title: "Heritage Gold", tag: "EVENTO FORMAL", img: inv3 },
    { title: "Botanical Garden", tag: "EDICIÓN JARDÍN", img: inv4 },
    { title: "Navy Royal", tag: "GALA NOCTURNA", img: inv1 }, // Reutilizando para completar 6
    { title: "Minimal Shadow", tag: "EDICIÓN LIMITADA", img: inv2 }  // Reutilizando para completar 6
];
---
<section class="py-20 px-6 max-w-7xl mx-auto overflow-hidden">
    <div class="flex justify-between items-end mb-12">
        <div>
            <h2 class="text-4xl font-serif mb-2 font-['Cormorant_Garamond']">Nuestros Diseños</h2>
            <p class="text-slate-400 text-sm italic">Inspiración para tu próximo gran evento.</p>
        </div>
        <div class="flex gap-3">
            <button id="prevBtn" class="w-12 h-12 border border-slate-200 rounded-full flex items-center justify-center hover:bg-slate-900 hover:text-white transition-all active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button id="nextBtn" class="w-12 h-12 border border-slate-200 rounded-full flex items-center justify-center hover:bg-slate-900 hover:text-white transition-all active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </div>
    </div>

    <div id="sliderContainer" class="flex gap-8 overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-8 scroll-smooth">
        {designs.map(d => (
                <div class="card-item snap-center group">
                    <div class="aspect-[3/4] rounded-[3rem] overflow-hidden bg-slate-50 shadow-sm border border-slate-100 mb-6 transition-all duration-500 group-hover:shadow-2xl group-hover:-translate-y-2 flex items-center justify-center p-6">
                        <Image
                                src={d.img}
                                alt={d.title}
                                class="max-w-full max-h-full object-contain"
                        />
                    </div>
                </div>
        ))}
    </div>
</section>

<style>
    .card-item {
        flex: 0 0 100%;
    }

    @media (min-width: 768px) {
        .card-item {
            flex: 0 0 calc(33.333% - 21.33px);
        }
    }

    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
    const setupSlider = () => {
        const container = document.getElementById('sliderContainer');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');

        if (!container || !prevBtn || !nextBtn) return;

        const getScrollAmount = () => {
            const card = container.querySelector('.card-item');
            return card ? card.clientWidth + 32 : 400;
        };

        nextBtn.addEventListener('click', () => {
            container.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });

        prevBtn.addEventListener('click', () => {
            container.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });
    };

    setupSlider();
    document.addEventListener('astro:after-swap', setupSlider);
</script>
