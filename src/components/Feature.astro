---
// src/components/Features.astro
import {Image} from "astro:assets";

import celebracion_cumpleanios from '@/assets/features/celebracion_cumpleanios.png'
import detalles_de_boda from '@/assets/features/detalles_de_boda.png'

const features = [
    {
        title: 'Bodas',
        subtitle: 'SOFISTICACIÓN Y ROMANCE',
        linkText: 'Ver detalles',
        linkHref: '#bodas',
        img: detalles_de_boda,
        alt: 'Manos de novios sosteniendo un ramo de flores'
    },
    {
        title: 'Cumpleaños',
        subtitle: 'ALEGRÍA Y COLOR',
        linkText: 'Ver detalles',
        linkHref: '#cumpleanos',
        img: celebracion_cumpleanios,
        alt: 'Globos grises flotando con destellos'
    },
];
---
<section class="py-24 bg-[#f8fafc] border-y border-slate-100">
    <div class="max-w-7xl mx-auto px-6 text-center">

        <div class="mb-16 max-w-2xl mx-auto">
            <!-- Actualizado a Newsreader para consistencia con el Hero -->
            <h2 class="text-4xl font-newsreader text-slate-900 mb-4">
                Momentos a Medida
            </h2>
            <p class="text-gris-claro-texto-a text-[16px] font-jakarta">
                Diseñamos experiencias digitales para cada tipo de celebración, <br/>
                manteniendo la esencia de lo clásico.
            </p>
        </div>

        <!-- max-w-4xl centra las features y gap-12 aplica los 48px de separación -->
        <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
            {features.map(item => (
                    <div class="flex flex-col items-center group">
                        <div class="relative w-[300px] h-[300px] md:w-[380px] md:h-[380px] rounded-full overflow-hidden
                                border-[12px] border-white shadow-xl shadow-slate-200/50
                                transition-transform duration-500 group-hover:scale-105 mb-10">
                            <Image
                                    src={item.img}
                                    alt={item.alt}
                                    format="webp"
                                    class="w-full h-full object-cover grayscale-[15%] group-hover:grayscale-0 transition duration-500"
                            />
                            <div class="absolute inset-0 bg-slate-900/5 group-hover:bg-transparent transition"></div>
                        </div>

                        <h3 class="text-[30px] font-newsreader text-slate-900 mb-2">
                            {item.title}
                        </h3>

                        <p class="text-[14px] uppercase mb-5 text-gris-claro-texto-a font-jakarta tracking-wider">
                            {item.subtitle}
                        </p>

                        <a
                                href={item.linkHref}
                                class="font-semibold text-azul-oscuro hover:text-blue-900 transition underline underline-offset-[6px] decoration-blue-200 hover:decoration-blue-400 font-jakarta"
                        >
                            {item.linkText}
                        </a>
                    </div>
            ))}
        </div>
    </div>
</section>
