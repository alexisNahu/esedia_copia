    ---
    const designs = [
        { title: 'L’Amour Minimaliste', category: 'Boda • Noire', img: '/inv1.jpg' },
        { title: 'Golden Frame', category: 'Elegancia • Clásico', img: '/inv2.jpg' },
        { title: 'Modern Abstract', category: 'XV Años • Limpio', img: '/inv3.jpg' },
        { title: 'Heritage Gold', category: 'Boda • Vintage', img: '/inv4.jpg' },
        { title: 'Botanical Garden', category: 'Boda • Natural', img: '/inv5.jpg' },
        { title: 'Navy Royal', category: 'Gala • Ejecutivo', img: '/inv6.jpg' },
        { title: 'Shadow Play', category: 'Minimal • Dark', img: '/inv7.jpg' },
        { title: 'Tropical Vibes', category: 'Cumpleaños • Color', img: '/inv8.jpg' },
    ];
    ---
    <section class="py-24 px-6 max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl mb-4">Catálogo Completo</h2>
            <p class="text-slate-500 max-w-lg mx-auto">Explora nuestra colección de diseños premium. Una amplia variedad para cada estilo y tipo de evento.</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {designs.map(design => (
                    <div class="group cursor-pointer">
                        <div class="overflow-hidden rounded-xl bg-slate-100 mb-4 shadow-sm group-hover:shadow-xl group-hover:-translate-y-1 transition-all duration-300">
                            <img
                                    src={design.img}
                                    alt={design.title}
                                    class="w-full aspect-square object-cover grayscale-[20%] group-hover:grayscale-0 transition"
                            />
                        </div>
                    </div>
            ))}
        </div>

        <div class="mt-16 text-center">
            <button class="border border-slate-200 px-10 py-3 rounded-full text-sm font-medium hover:bg-slate-50 transition bg-blue-900 text-white">
                Cargar más diseños
            </button>
        </div>
    </section>
