---
import { Image } from "astro:assets";

// 1. Importaciones manuales (Ruta directa)
import card1 from "../assets/catalogo/card_1.png";
import card2 from "../assets/catalogo/card_2.png";
import card3 from "../assets/catalogo/card_3.png";
import card4 from "../assets/catalogo/card_4.png";
import card5 from "../assets/catalogo/card_5.png";
import card6 from "../assets/catalogo/card_6.png";
import card7 from "../assets/catalogo/card_7.png";
import card8 from "../assets/catalogo/card_8.png";

const designs = [
    { title: 'L’Amour Minimaliste', category: 'Boda • Noire', img: card1, tag: 'EDICIÓN BODA' }, // Added 'tag' for text animation
    { title: 'Golden Frame', category: 'Elegancia • Clásico', img: card2, tag: 'EDICIÓN CLÁSICA' },
    { title: 'Modern Abstract', category: 'XV Años • Limpio', img: card3, tag: 'XV AÑOS MODERNO' },
    { title: 'Heritage Gold', category: 'Boda • Vintage', img: card4, tag: 'BODA VINTAGE' },
    { title: 'Botanical Garden', category: 'Boda • Natural', img: card5, tag: 'EDICIÓN NATURAL' },
    { title: 'Navy Royal', category: 'Gala • Ejecutivo', img: card6, tag: 'GALA EJECUTIVA' },
    { title: 'Shadow Play', category: 'Minimal • Dark', img: card7, tag: 'EDICIÓN OSCURA' },
    { title: 'Tropical Vibes', category: 'Cumpleaños • Color', img: card8, tag: 'EDICIÓN COLORIDA' },
];
---

<section class="py-24 mx-auto bg-gris-claro-fondo-b">
    <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
        <h2 class="text-[48px] mb-4 font-newsreader">Catálogo Completo</h2>
        <p class="text-gris-claro-texto-b font-jakarta max-w-[662px] mx-auto">Explora nuestra colección de diseños premium. Una amplia variedad de estilos para cada personalidad y tipo de evento</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {designs.map((design) => (
                <div class="group cursor-pointer">
                    <div class="overflow-hidden rounded-xl bg-slate-100 mb-4 shadow-sm group-hover:shadow-xl group-hover:-translate-y-1 transition-all duration-300 aspect-square relative"> {/* Added 'relative' and 'rounded-xl' to match the design card shape */}
                        <Image
                                src={design.img}
                                alt={design.title}
                                class="w-full h-full object-fill grayscale-[20%] group-hover:grayscale-0 transition duration-500 scale-100 group-hover:scale-105" /* Modified: added scale transform to image */
                        />
                        {/* 2. Overlays the text on hover */}
                        <div class="absolute inset-x-0 bottom-0 p-6 flex flex-col justify-end h-1/2 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-b-xl"> {/* Added gradient overlay and rounded corners */}
                            <p class="text-[12px] uppercase mb-1 text-white/70 font-jakarta tracking-wider">
                                {design.tag}
                            </p>
                            <h3 class="text-[20px] font-newsreader text-white mb-2 leading-tight">
                                {design.title}
                            </h3>
                            <a
                                    href="#"
                                    class="text-[12px] font-semibold text-white/70 hover:text-white transition underline underline-offset-[4px] decoration-white/30 hover:decoration-white font-jakarta inline-block mt-1"
                            >
                                Ver detalles
                            </a>
                        </div>
                    </div>
                </div>
        ))}
    </div>

    <div class="mt-16 text-center">
        <button class="border border-slate-200 px-10 py-3 rounded-full text-sm font-semibold hover:bg-blue-800 transition bg-azul-oscuro text-white shadow-lg shadow-blue-900/20">
            Cargar más diseños
        </button>
    </div>
    </div>
</section>
