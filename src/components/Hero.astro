---
import { Image } from "astro:assets";
import { type ImageMetadata } from "astro";

// Cargamos las imágenes
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hero/item*.png');
const imagesArray = Object.values(images);

const col1 = [...imagesArray.slice(0, 3), ...imagesArray.slice(0, 3)];
const col2 = [...imagesArray.slice(3, 6), ...imagesArray.slice(3, 6)];
---

<section class="mx-auto px-6 py-16 grid md:grid-cols-2 gap-12 items-center overflow-hidden mt-36">
    <div>
        <span class="text-[#00436D] text-[12px] font-jakarta py-[6px] px-[16px] rounded-[20px] bg-celeste-claro font-semibold uppercase">Elegancia Digital</span>
            <h1 class="text-[72px] font-newsreader leading-[1.2] mt-9">
                Invitaciones que <br/>
                <span class="font-newsreader italic text-azul-oscuro -mt-4 block">
                    cuentan tu historia
                </span>
            </h1>
        <p class="mt-6 text-[18px] font-jakarta text-gris-claro-texto-b w-[512px]">
            Transformamos la tradición del papel en una experiencia
            digital sofisticada. Diseños exclusivos para momentos
            inolvidables.
        </p>
        <div class="mt-10 flex gap-4">
            <button class="bg-azul-oscuro text-white px-8 py-3 rounded-full hover:bg-blue-900 transition shadow-lg shadow-blue-900/20">
                Comenzar ahora
            </button>
            <button class="border border-slate-300 px-8 py-3 rounded-full hover:bg-slate-50 transition">
                <a href="#catalogo">Ver Catálogo</a>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 h-[600px] overflow-hidden relative mask-edge">

        <div class="flex flex-col gap-4 animate-vertical-scroll">
            {col1.map((img, i) => (
                    <Image
                            src={img()}
                            alt="Evento"
                            format="webp"
                            class="w-full object-cover"
                    />
            ))}
        </div>

        <div class="flex flex-col gap-4 animate-vertical-scroll">
            {col2.map((img, i) => (
                    <Image
                            src={img()}
                            alt="Evento"
                            format="webp"
                            class="w-full object-cover"
                    />
            ))}
        </div>
    </div>
</section>

<style>
    @keyframes scroll {
        0% { transform: translateY(0); }
        100% { transform: translateY(-50%); }
    }

    .animate-vertical-scroll {
        animation: scroll 25s linear infinite;
    }

    .animate-vertical-scroll-slow {
        animation: scroll 35s linear infinite;
    }

    .animate-vertical-scroll:hover,
    .animate-vertical-scroll-slow:hover {
        animation-play-state: paused;
    }

    .mask-edge {
        mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
        -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
    }
</style>
