---
import { Image } from "astro:assets";
import { type ImageMetadata } from "astro";

// Cargamos las imágenes
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hero/item*.png');
const imagesArray = Object.values(images);

const col1 = [...imagesArray.slice(0, 3), ...imagesArray.slice(0, 3)];
const col2 = [...imagesArray.slice(3, 6), ...imagesArray.slice(3, 6)];
---

<section class="mx-auto px-6 md:px-12 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center overflow-hidden mt-20 md:mt-30 bg-gris-claro-fondo-b">

    <div class="text-center md:text-left flex flex-col items-center md:items-start order-2 md:order-1">
        <span class="text-[#00436D] text-[11px] md:text-[12px] font-jakarta py-[6px] px-[16px] rounded-[20px] bg-celeste-claro font-semibold uppercase">Elegancia Digital</span>

        <h1 class="text-[36px] md:text-[72px] font-newsreader leading-tight md:leading-[1.2] mt-6 md:mt-9">
            Invitaciones que <br class="hidden md:inline"/>
            <span class="font-newsreader italic text-azul-oscuro md:-mt-4 block">
                cuentan tu historia
            </span>
        </h1>

        <p class="mt-4 md:mt-6 text-[15px] md:text-[18px] font-jakarta text-gris-claro-texto-b w-full max-w-lg">
            Transformamos la tradición del papel en una experiencia
            digital sofisticada. Diseños exclusivos para momentos
            inolvidables.
        </p>

        <div class="mt-8 md:mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <button class="bg-azul-oscuro text-white px-8 py-3 rounded-full hover:bg-blue-900 transition shadow-lg shadow-blue-900/20 w-full sm:w-auto text-[15px] md:text-[16px]">
                Comenzar ahora
            </button>
            <button class="border border-slate-300 px-8 py-3 rounded-full hover:bg-slate-50 transition w-full sm:w-auto text-[15px] md:text-[16px]">
                <a href="#catalogo" class="block w-full">Ver Catálogo</a>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 h-[350px] md:h-[600px] overflow-hidden relative mask-edge order-1 md:order-2">

        <div class="flex flex-col gap-4 animate-vertical-scroll">
            {col1.map((img, i) => (
                    <Image
                            src={img()}
                            alt="Evento"
                            format="webp"
                            class="w-full object-cover"
                    />
            ))}
        </div>

        <div class="flex flex-col gap-4 animate-vertical-scroll">
            {col2.map((img, i) => (
                    <Image
                            src={img()}
                            alt="Evento"
                            format="webp"
                            class="w-full object-cover"
                    />
            ))}
        </div>
    </div>
</section>

<style>
    @keyframes scroll {
        0% { transform: translateY(0); }
        100% { transform: translateY(-50%); }
    }

    .animate-vertical-scroll {
        animation: scroll 25s linear infinite;
    }

    .animate-vertical-scroll-slow {
        animation: scroll 35s linear infinite;
    }

    .animate-vertical-scroll:hover,
    .animate-vertical-scroll-slow:hover {
        animation-play-state: paused;
    }

    .mask-edge {
        mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
        -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
    }
</style>
