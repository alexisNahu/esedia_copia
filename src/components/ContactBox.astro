---
import {Image} from 'astro:assets'
import mapa from '@/assets/mapa.jpeg'
// src/components/ContactBox.astro
---
<section class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-slate-50 rounded-[3rem] overflow-hidden grid md:grid-cols-2 items-center">
        <div class="p-12 md:p-20">
            <h2 class="text-5xl font-serif mb-6">
                Hablemos de <br/> <span class="italic text-blue-700">tu evento</span>
            </h2>
            <p class="text-slate-500 mb-10 leading-relaxed">
                Nuestro equipo está listo para ayudarte a crear la invitación perfecta. Atendemos de forma personalizada para asegurar que cada detalle sea impecable.
            </p>

            <button class="bg-[#1e4b7a] text-white px-8 py-4 rounded-2xl flex items-center gap-3 shadow-lg hover:bg-blue-900 transition mb-8">
                <span>💬 Escribir por WhatsApp</span>
            </button>

            <div class="space-y-3 text-sm text-slate-400">
                <p class="flex items-center gap-2">✉️ hola@evella.com</p>
                <p class="flex items-center gap-2">📍 Studio Boutique, Barcelona</p>
            </div>
        </div>

        <Image
            src={mapa}
            alt="Mapa del evento"
            class={"w-full h-auto grayscale-[30%]"}
        />
    </div>
</section>
